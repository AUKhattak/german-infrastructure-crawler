# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/

# Virtual environments
.venv/
venv/
env/
ENV/

# Test and coverage reports
.coverage
.coverage.*
coverage.xml
htmlcov/
.hypothesis/

# Build and packaging output
build/
dist/
*.egg-info/
pip-wheel-metadata/

# Crawler runtime output
logs/*
output/*
!logs/.gitkeep
!output/.gitkeep

# Local configuration and secrets
.env
.env.*
!.env.example

# IDE and operating-system files
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
*.swo

# Temporary files
*.tmp
*.temp
*.bak
*.log